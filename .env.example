# simple-ocr configuration. Copy this file to .env and edit it.
# One KEY=VALUE per line, no quotes needed, comments only on their own lines.
# .env is git-ignored and is never copied into the container image.

# Which model server to use: lmstudio, ollama, vllm or llamacpp (default lmstudio).
# Each one has its own block below, so you can keep all of them configured and switch here.
BACKEND=lmstudio

# ---- LM Studio (host or IP, and the port shown in LM Studio's server settings)
LMSTUDIO_HOST=192.0.2.10
LMSTUDIO_PORT=1234
# API key, only if the server requires one. Leave empty otherwise.
LMSTUDIO_API_KEY=
# Optional: a full URL instead of host and port, e.g. https://lm.example:8443 (wins over host/port)
LMSTUDIO_URL=
# https with a self-signed certificate (e.g. behind a reverse proxy): false accepts any certificate.
# The connection stays encrypted, but the server is no longer authenticated. Default true.
LMSTUDIO_TLS_VERIFY=true

# ---- Ollama (default port 11434). OLLAMA_HOST may also be "host:port" or a URL, as for Ollama itself.
OLLAMA_HOST=192.0.2.10
OLLAMA_PORT=11434
# Ollama has no API key of its own; set one if a proxy in front of it expects a Bearer token.
OLLAMA_API_KEY=
OLLAMA_URL=
OLLAMA_TLS_VERIFY=true

# ---- vLLM (default port 8000). The key is the one given to "vllm serve --api-key".
VLLM_HOST=192.0.2.10
VLLM_PORT=8000
VLLM_API_KEY=
VLLM_URL=
VLLM_TLS_VERIFY=true

# ---- llama.cpp llama-server (default port 8080). The key is the one given to "--api-key".
# A server started with a model and --mmproj serves that one model; in router mode
# (--models-dir or the model cache) the benchmark can load and unload models.
LLAMACPP_HOST=192.0.2.10
LLAMACPP_PORT=8080
LLAMACPP_API_KEY=
LLAMACPP_URL=
LLAMACPP_TLS_VERIFY=true

# Optional: model id to preselect. Empty = first loaded vision model.
DEFAULT_MODEL=

# Features of the web interface: true or false. Switched off, the server refuses them too
# (HTTP 403), not only the page hides them.
# CUSTOM_PROMPT: the prompt can be edited on the main page and sent with the image.
CUSTOM_PROMPT=true
# DEBUG_PAGE: the Debug button, the benchmark page /debug and every /api/debug route.
DEBUG_PAGE=true
# BATCH_PAGE: the Batch button, the batch page /batch and every /api/batch route.
BATCH_PAGE=true
# Largest batch upload in MB (images and ZIP archives together); each image keeps MAX_UPLOAD_MB.
MAX_BATCH_MB=200

# Optional: language of the "Describe image" answer
DESCRIBE_LANGUAGE=German

# Optional: upload limit in MB, seconds to wait for the model
MAX_UPLOAD_MB=20
UPSTREAM_TIMEOUT=300

# Optional: where finished benchmark runs are saved. The image uses /data, the volume simple-ocr-data.
# Set it only when running without a container; empty = runs are not saved.
# DATA_DIR=

# Port and address on this machine where the web page is published (run.sh, start.sh, compose).
# 127.0.0.1 = only this machine. 0.0.0.0 = every network interface, e.g. on a remote server:
# the app has no login of its own, so do that only on a trusted network or behind a proxy with login.
APP_PORT=8080
APP_BIND=127.0.0.1
